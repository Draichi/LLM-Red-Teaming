.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# Large / generated data and run artifacts — keep the harness, not the payloads.
data/calibration/*.json
data/calibration/*.jsonl
data/calibration/*.csv
# Arena response transcripts (real Gray Swan content) -- the user's work product.
data/calibration/*.txt
data/runs/*.jsonl
# Validated attack vectors: the user's red-teaming work product, never versioned.
data/vectors/
# Unscreened candidate payloads and validation scripts -- also never versioned.
data/candidates/
# Per-scenario writeups (intel, kill log, payloads) -- work product, never versioned.
data/writeups/
# Per-call spend ledger (SQLite) -- local telemetry, regenerated every run.
data/ledger.db
reports/*.md
reports/*.png
reports/*.jsonl

# But keep the placeholder objective file tracked.
!data/behaviors/objectives.jsonl

# Secrets: never version the API key. Fill .env locally; .env.example is tracked.
.env
.env.local
.env.*.local
