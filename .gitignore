.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# Local evaluation artifacts and Arena evidence are private working data.
data/calibration/*.json
data/calibration/*.jsonl
data/calibration/*.csv
# Arena round material (URLs, traces, and autopsies) is private working data.
data/calibration/*.txt
data/runs/*.jsonl
data/runs/arena/
# Validated attack vectors: the user's red-teaming work product, never versioned.
data/vectors/
# Unscreened candidate payloads and validation scripts -- also never versioned.
data/candidates/
# Per-scenario writeups (intel, kill log, payloads) -- work product, never versioned.
data/writeups/
# Per-call spend ledger (SQLite) -- local telemetry, regenerated every run.
data/ledger.db
# Legacy local mechanism artifacts remain ignored as private working data.
data/mechanisms.jsonl
# Local pattern corpora and source collections remain unversioned.
data/patterns.jsonl
data/patterns_*/
# Arena evaluations and response records are local event data.
data/arena_truth.jsonl
reports/*.md
reports/*.png
reports/*.jsonl
# Strategy-level event writeups (no working attack strings) are versioned;
# scenario-specific writeups with payload-adjacent detail stay local under
# data/writeups/.
!reports/direct_agent_event.md
!reports/breaking_ties_event.md
!reports/ipi_black_prep.md
!reports/ipi_black_operational_checklist.md
!reports/ipi_black_w1_lessons.md

# But keep the placeholder objective file tracked.
!data/behaviors/objectives.jsonl

# Secrets and credentials are never versioned. Fill .env locally.
.env
.env.local
.env.*.local

# Local evaluation reports and benign corpora are never committed.
data/runs/*.json
data/benign/

# grayswan-reader (Arena page reader): login cookies + scraped Arena pages --
# same policy as data/: present locally, never versioned.
grayswan-reader/browser_profile*/
grayswan-reader/pages/
